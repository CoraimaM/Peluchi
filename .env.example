# ---------------------------------------------------------------
# Peluchi - Tienda de peluches de coleccionista
# Copia este archivo como .env y ajusta los valores
# ---------------------------------------------------------------

# Base de datos PostgreSQL
DATABASE_URL=postgresql+psycopg://peluchi:PELUCHI_DEV_PASS@localhost:5432/peluchi_db

# Seguridad JWT (cámbialo en producción: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=cambia-esta-clave-secreta-por-una-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL debe apuntar a: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URLs
FRONTEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Usuario administrador inicial (seed)
ADMIN_EMAIL=admin@peluchi.es
ADMIN_PASSWORD=admin1234
